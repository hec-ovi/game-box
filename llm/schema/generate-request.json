{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-box.dev/llm/generate-request",
  "title": "llm generate request",
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "role": { "enum": ["system", "user", "assistant"] },
          "content": { "type": "string" }
        },
        "required": ["role", "content"],
        "additionalProperties": false
      }
    },
    "model": { "type": "string" },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
  },
  "required": ["messages"],
  "additionalProperties": false
}
