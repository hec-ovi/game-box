{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "game-box.player"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "worldId": {
      "type": "string",
      "minLength": 1
    },
    "money": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stolen": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "flags": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "reputation": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -100,
        "maximum": 100
      }
    },
    "companions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clock": {
      "type": "object",
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "secondsOfDay": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 86400
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "weather": {
          "type": "string",
          "enum": [
            "clear",
            "overcast",
            "rain"
          ]
        }
      },
      "required": [
        "day",
        "secondsOfDay",
        "rate",
        "weather"
      ]
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "worldId",
    "money",
    "inventory",
    "stolen",
    "flags",
    "reputation",
    "companions"
  ]
}
