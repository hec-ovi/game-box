{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "game-box.player"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "worldId": {
      "type": "string",
      "minLength": 1
    },
    "money": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stolen": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "flags": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "reputation": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -100,
        "maximum": 100
      }
    },
    "companions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clock": {
      "type": "object",
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "secondsOfDay": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 86400
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "weather": {
          "type": "string",
          "enum": [
            "clear",
            "overcast",
            "rain"
          ]
        },
        "paused": {
          "type": "boolean"
        }
      },
      "required": [
        "day",
        "secondsOfDay",
        "rate",
        "weather"
      ]
    },
    "where": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "heading": {
          "type": "number"
        },
        "interiorId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "x",
        "z",
        "heading"
      ]
    },
    "tracked": {
      "type": "string",
      "minLength": 1
    },
    "moved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1
          },
          "interiorId": {
            "type": "string",
            "minLength": 1
          },
          "anchorId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "itemId",
          "interiorId",
          "anchorId"
        ]
      }
    },
    "codex": {
      "type": "object",
      "properties": {
        "places": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "people": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "npcId": {
                "type": "string",
                "minLength": 1
              },
              "unlocked": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "npcId",
              "unlocked"
            ]
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      },
      "required": [
        "places",
        "people"
      ]
    },
    "memory": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "disposition": {
            "type": "string",
            "enum": [
              "hostile",
              "cool",
              "neutral",
              "warm",
              "friendly"
            ]
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fact": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "told",
                    "seen"
                  ]
                }
              },
              "required": [
                "fact",
                "source"
              ]
            }
          }
        },
        "required": [
          "disposition",
          "facts"
        ]
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "worldId",
    "money",
    "inventory",
    "stolen",
    "flags",
    "reputation",
    "companions"
  ]
}
