{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "theme": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "blocksX": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 57
    },
    "blocksY": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 57
    },
    "blockCells": {
      "type": "integer",
      "minimum": 6,
      "maximum": 40
    },
    "density": {
      "default": 0.8,
      "type": "number",
      "minimum": 0.2,
      "maximum": 1
    },
    "maxStoreys": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "exits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "asks": {
      "type": "object",
      "properties": {
        "mainQuest": {
          "type": "string",
          "minLength": 1
        },
        "sideQuests": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "object",
          "properties": {
            "neon": {
              "type": "string",
              "enum": [
                "dark",
                "some",
                "lit"
              ]
            },
            "density": {
              "type": "string",
              "enum": [
                "sparse",
                "mixed",
                "dense"
              ]
            },
            "wear": {
              "type": "string",
              "enum": [
                "kept",
                "lived-in",
                "run-down"
              ]
            }
          }
        }
      }
    }
  },
  "required": [
    "theme",
    "seed"
  ]
}
