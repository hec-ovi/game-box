{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-box.dev/llm/token-event",
  "title": "llm token event",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": { "const": "token" },
        "text": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "done" },
        "finishReason": { "enum": ["stop", "length", "error"] }
      },
      "required": ["type", "finishReason"],
      "additionalProperties": false
    }
  ]
}
