{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "game-box.world"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^world_\\d{4,}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "theme": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "cellSize": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 16
    },
    "catalogues": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pack": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "pack",
          "version"
        ]
      }
    },
    "grid": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1024
        },
        "height": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1024
        },
        "rows": {
          "minItems": 4,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "width",
        "height",
        "rows"
      ]
    },
    "roads": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^node_\\d{4,}$"
              },
              "cell": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              }
            },
            "required": [
              "id",
              "cell"
            ]
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^road_\\d{4,}$"
              },
              "from": {
                "type": "string",
                "pattern": "^node_\\d{4,}$"
              },
              "to": {
                "type": "string",
                "pattern": "^node_\\d{4,}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "street",
                  "avenue",
                  "exit"
                ]
              },
              "lanes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            },
            "required": [
              "id",
              "from",
              "to",
              "kind",
              "lanes"
            ]
          }
        }
      },
      "required": [
        "nodes",
        "segments"
      ]
    },
    "plots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^plot_\\d{4,}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "house",
              "apartment",
              "bar",
              "cafe",
              "restaurant",
              "shop",
              "market",
              "office",
              "workshop",
              "warehouse",
              "clinic",
              "hotel",
              "station",
              "chapel"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "rect": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "w": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "h": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ]
          },
          "storeys": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          },
          "entrance": {
            "type": "object",
            "properties": {
              "cell": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              },
              "facing": {
                "type": "string",
                "enum": [
                  "north",
                  "east",
                  "south",
                  "west"
                ]
              }
            },
            "required": [
              "cell",
              "facing"
            ]
          },
          "style": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "interiorId": {
            "type": "string",
            "pattern": "^interior_\\d{4,}$"
          },
          "design": {
            "type": "object",
            "properties": {
              "pack": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "mirror": {
                "type": "boolean"
              },
              "rooms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "pack",
              "model",
              "mirror",
              "rooms"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "rect",
          "storeys",
          "entrance",
          "style"
        ]
      }
    },
    "interiors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^interior_\\d{4,}$"
          },
          "plotId": {
            "type": "string",
            "pattern": "^plot_\\d{4,}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "house",
              "apartment",
              "bar",
              "cafe",
              "restaurant",
              "shop",
              "market",
              "office",
              "workshop",
              "warehouse",
              "clinic",
              "hotel",
              "station",
              "chapel"
            ]
          },
          "size": {
            "type": "object",
            "properties": {
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "w",
              "h"
            ]
          },
          "rooms": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^room_\\d{4,}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "main",
                    "bedroom",
                    "kitchen",
                    "bathroom",
                    "storage",
                    "office",
                    "hall",
                    "cellar",
                    "backroom"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "rect": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ]
                }
              },
              "required": [
                "id",
                "kind",
                "name",
                "rect"
              ]
            }
          },
          "doors": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^door_\\d{4,}$"
                },
                "from": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "outside"
                    },
                    {
                      "type": "string",
                      "pattern": "^room_\\d{4,}$"
                    }
                  ]
                },
                "to": {
                  "type": "string",
                  "pattern": "^room_\\d{4,}$"
                },
                "pos": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ]
                },
                "rot": {
                  "type": "number",
                  "minimum": -360,
                  "maximum": 360
                },
                "locked": {
                  "default": false,
                  "type": "boolean"
                },
                "keyItemId": {
                  "type": "string",
                  "pattern": "^item_\\d{4,}$"
                }
              },
              "required": [
                "id",
                "from",
                "to",
                "pos",
                "rot"
              ]
            }
          },
          "furniture": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^prop_\\d{4,}$"
                },
                "prop": {
                  "type": "string",
                  "enum": [
                    "bar-counter",
                    "bar-stool",
                    "table",
                    "chair",
                    "sofa",
                    "bed",
                    "desk",
                    "office-chair",
                    "shelf",
                    "cabinet",
                    "wardrobe",
                    "fridge",
                    "stove",
                    "sink",
                    "counter",
                    "register",
                    "display-case",
                    "crate-stack",
                    "plant",
                    "lamp",
                    "rug",
                    "tv",
                    "coffee-machine",
                    "jukebox"
                  ]
                },
                "roomId": {
                  "type": "string",
                  "pattern": "^room_\\d{4,}$"
                },
                "pos": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ]
                },
                "rot": {
                  "type": "number",
                  "minimum": -360,
                  "maximum": 360
                },
                "lift": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                }
              },
              "required": [
                "id",
                "prop",
                "roomId",
                "pos",
                "rot"
              ]
            }
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^anchor_\\d{4,}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "stand",
                    "sit",
                    "sit-drink",
                    "serve",
                    "cook",
                    "work-desk",
                    "work-bench",
                    "sleep",
                    "browse",
                    "lean",
                    "guard"
                  ]
                },
                "roomId": {
                  "type": "string",
                  "pattern": "^room_\\d{4,}$"
                },
                "pos": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ]
                },
                "rot": {
                  "type": "number",
                  "minimum": -360,
                  "maximum": 360
                },
                "propId": {
                  "type": "string",
                  "pattern": "^prop_\\d{4,}$"
                }
              },
              "required": [
                "id",
                "kind",
                "roomId",
                "pos",
                "rot"
              ]
            }
          }
        },
        "required": [
          "id",
          "plotId",
          "kind",
          "size",
          "rooms",
          "doors",
          "furniture",
          "anchors"
        ]
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^npc_\\d{4,}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "role": {
            "type": "string",
            "enum": [
              "bartender",
              "patron",
              "clerk",
              "resident",
              "worker",
              "vendor",
              "cook",
              "receptionist",
              "mechanic",
              "courier",
              "guard",
              "wanderer"
            ]
          },
          "appearance": {
            "type": "object",
            "properties": {
              "base": {
                "type": "string",
                "enum": [
                  "male",
                  "female"
                ]
              },
              "variant": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              }
            },
            "required": [
              "base",
              "variant"
            ]
          },
          "station": {
            "type": "object",
            "properties": {
              "interiorId": {
                "type": "string",
                "pattern": "^interior_\\d{4,}$"
              },
              "anchorId": {
                "type": "string",
                "pattern": "^anchor_\\d{4,}$"
              }
            },
            "required": [
              "interiorId",
              "anchorId"
            ]
          },
          "homePlotId": {
            "type": "string",
            "pattern": "^plot_\\d{4,}$"
          },
          "workPlotId": {
            "type": "string",
            "pattern": "^plot_\\d{4,}$"
          },
          "personality": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "knowledge": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "voice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "appearance",
          "personality",
          "knowledge"
        ]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^item_\\d{4,}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "archetype": {
            "type": "string",
            "enum": [
              "bottle",
              "glass",
              "crate",
              "box",
              "parcel",
              "book",
              "ledger",
              "envelope",
              "key",
              "keycard",
              "bag",
              "briefcase",
              "toolbox",
              "wrench",
              "painting",
              "statue",
              "phone",
              "radio",
              "plate",
              "cup",
              "cash",
              "gem",
              "flower",
              "medkit",
              "fuelcan"
            ]
          },
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "bulk": {
            "default": "pocket",
            "type": "string",
            "enum": [
              "pocket",
              "bag",
              "two-handed"
            ]
          },
          "ownerNpcId": {
            "type": "string",
            "pattern": "^npc_\\d{4,}$"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "archetype",
          "value"
        ]
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "const": "anchor"
              },
              "itemId": {
                "type": "string",
                "pattern": "^item_\\d{4,}$"
              },
              "interiorId": {
                "type": "string",
                "pattern": "^interior_\\d{4,}$"
              },
              "anchorId": {
                "type": "string",
                "pattern": "^anchor_\\d{4,}$"
              }
            },
            "required": [
              "at",
              "itemId",
              "interiorId",
              "anchorId"
            ]
          },
          {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "const": "npc"
              },
              "itemId": {
                "type": "string",
                "pattern": "^item_\\d{4,}$"
              },
              "npcId": {
                "type": "string",
                "pattern": "^npc_\\d{4,}$"
              }
            },
            "required": [
              "at",
              "itemId",
              "npcId"
            ]
          },
          {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "const": "ground"
              },
              "itemId": {
                "type": "string",
                "pattern": "^item_\\d{4,}$"
              },
              "cell": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              }
            },
            "required": [
              "at",
              "itemId",
              "cell"
            ]
          }
        ]
      }
    },
    "idCounters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "id",
    "name",
    "theme",
    "seed",
    "generator",
    "cellSize",
    "grid",
    "roads",
    "plots",
    "interiors",
    "npcs",
    "items",
    "placements",
    "idCounters"
  ]
}
