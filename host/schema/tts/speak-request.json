{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "voice": {
      "type": "string",
      "minLength": 1
    },
    "sampleRate": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 48000
    },
    "speed": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 2
    }
  },
  "required": [
    "voice"
  ],
  "additionalProperties": false,
  "$id": "game-box.dev/tts/speak-request",
  "title": "tts speak request (session parameters)"
}
