{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "frame"
        },
        "mediaType": {
          "type": "string",
          "const": "audio/pcm;bits=16"
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 48000
        },
        "channels": {
          "type": "number",
          "const": 1
        },
        "dataBase64": {
          "type": "string",
          "minLength": 4,
          "contentEncoding": "base64"
        }
      },
      "required": [
        "type",
        "mediaType",
        "sampleRate",
        "channels",
        "dataBase64"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "end"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "durationMs"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "game-box.dev/tts/audio-event",
  "title": "tts audio event"
}
