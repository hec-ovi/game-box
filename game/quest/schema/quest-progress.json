{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "game-box.quest-progress"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "quests": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unstarted",
              "active",
              "complete",
              "failed"
            ]
          },
          "open": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "done": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "credited": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "revealed": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "abandoned": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startedAt": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failReason": {
            "type": "string",
            "enum": [
              "fail-step",
              "time-limit",
              "npc-lost",
              "item-lost"
            ]
          }
        },
        "required": [
          "status",
          "open",
          "done"
        ]
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "quests"
  ]
}
