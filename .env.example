# Settings for the local AI sidecar (host/). Copy to .env and fill in what you
# need. Nothing is loaded automatically: run with `node --env-file=.env ...`.

# Where text generation goes.
#   unset        the built-in stand-in, so the model path runs with no model
#   openrouter   the hosted router, which needs OPENROUTER_API_KEY below
#   a URL        an OpenAI-compatible server of your own, called without auth
GAME_BOX_LLM_UPSTREAM=http://127.0.0.1:8080

# Only read when GAME_BOX_LLM_UPSTREAM is the word openrouter. Never sent
# anywhere else.
OPENROUTER_API_KEY=

# Where the sidecar listens.
GAME_BOX_PORT=8976
