{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-box.dev/api/realtime-client-event",
  "title": "/v1/realtime client-to-server event",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": { "const": "input_audio_buffer.append" },
        "audio": {
          "type": "object",
          "properties": {
            "mediaType": { "const": "audio/pcm;bits=16" },
            "sampleRate": { "type": "integer", "minimum": 8000, "maximum": 48000 },
            "channels": { "const": 1 },
            "dataBase64": { "type": "string", "minLength": 4, "contentEncoding": "base64" }
          },
          "required": ["mediaType", "sampleRate", "dataBase64"],
          "additionalProperties": false
        }
      },
      "required": ["type", "audio"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "type": { "const": "input_audio_buffer.commit" } },
      "required": ["type"],
      "additionalProperties": false
    }
  ]
}
