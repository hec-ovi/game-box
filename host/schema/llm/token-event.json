{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "token"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "tool-call"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object",
          "properties": {},
          "additionalProperties": {},
          "description": "Parsed arguments. Unparseable JSON never reaches here."
        },
        "salvaged": {
          "type": "boolean",
          "const": true,
          "description": "The engine wrote the arguments as prose instead of calling; the call was rebuilt from it."
        }
      },
      "required": [
        "type",
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "done"
        },
        "finishReason": {
          "type": "string",
          "enum": [
            "stop",
            "length",
            "error"
          ]
        }
      },
      "required": [
        "type",
        "finishReason"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "game-box.dev/llm/token-event",
  "title": "llm token event"
}
